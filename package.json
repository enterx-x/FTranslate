{
  "name": "pdf-translation-reader",
  "version": "0.1.12",
  "description": "Local offline PDF original text and Chinese translation reader for Windows desktop.",
  "main": "dist-electron/main/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && npm run build:electron && electron dist-electron/main/main.js\"",
    "dev:mobile": "vite --mode mobile --host 0.0.0.0",
    "serve:mobile": "npm run build:mobile && vite preview --mode mobile --host 0.0.0.0 --port 4174",
    "test": "vitest run --dir src",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build:mobile": "vite build --mode mobile",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run test && npm run typecheck && npm run build:renderer && npm run build:electron",
    "dist": "npm run build && set ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/&& electron-builder",
    "demo:research-loop": "tsc -p tsconfig.demo.json && node .tmp-demo-build/scripts/research-loop-demo.js",
    "demo:code-repo": "tsc -p tsconfig.demo.json && node .tmp-demo-build/scripts/code-repo-demo.js",
    "visual:check": "node scripts/visual-check.mjs",
    "visual:check:mobile": "node scripts/mobile-visual-check.mjs",
    "test:mobile:corpus": "vitest run scripts/mobile-pdf-corpus-check.test.ts --reporter=verbose",
    "ios:add": "npm run build:mobile && cap add ios && node scripts/normalize-capacitor-spm-paths.mjs",
    "ios:sync": "npm run build:mobile && cap sync ios && node scripts/normalize-capacitor-spm-paths.mjs",
    "ios:prepare-download": "node scripts/prepare-ios-download.mjs",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.1",
    "@capacitor/file-transfer": "^2.0.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/preferences": "^8.0.1",
    "@univerjs/preset-sheets-conditional-formatting": "^0.24.0",
    "@univerjs/preset-sheets-core": "^0.24.0",
    "@univerjs/preset-sheets-data-validation": "^0.24.0",
    "@univerjs/presets": "^0.24.0",
    "@xmldom/xmldom": "^0.8.13",
    "exceljs": "^4.4.0",
    "katex": "^0.17.0",
    "pdfjs-dist": "5.7.284",
    "pptxgenjs": "^4.0.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.4",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tesseract.js": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.0.14",
    "wait-on": "^9.0.3"
  },
  "overrides": {
    "axios": "^1.18.1",
    "protobufjs": "^7.6.5",
    "brace-expansion@<1.1.16": "1.1.16",
    "brace-expansion@>=2.0.0 <2.1.2": "2.1.2",
    "brace-expansion@>=3.0.0 <5.0.7": "5.0.7",
    "esbuild": "^0.28.1",
    "form-data": "^4.0.6",
    "js-yaml": "^4.3.0",
    "tar": "^7.5.21",
    "undici": "^6.27.0",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "build": {
    "appId": "com.local.pdf.translation.reader",
    "productName": "PDF Translation Reader",
    "directories": {
      "output": "dist"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist-renderer/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PDF Translation Reader"
    }
  }
}
